# ==============================================================================
# WHATSAPP AI REMINDER AUTOMATION - CONFIGURATION (.env)
# ==============================================================================

# Application Environment
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# SQLite Database (Zero infrastructure cost, WAL mode enabled)
DATABASE_URL=sqlite+aiosqlite:///./reminders.db

# Multi-Tenant JWT Authentication Secret
JWT_SECRET_KEY=replace_with_a_secure_random_secret_for_production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# WhatsApp Cloud API Webhook Verify Token (handshake secret)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=my_secure_webhook_verify_token

# ------------------------------------------------------------------------------
# Google Gemini API Configuration (Personalization Engine)
# Get a free key at: https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=12.0

# ------------------------------------------------------------------------------
# WhatsApp Gateway Configuration
# Options:
#   "meta"   -> Official Meta WhatsApp Cloud API (Graph API)
#   "bridge" -> Self-hosted QR bridge (WPPConnect / Baileys / Evolution API)
#   "mock"   -> Local dry-run testing (logs messages to console without sending)
# ------------------------------------------------------------------------------
WHATSAPP_GATEWAY_TYPE=meta

# Meta WhatsApp Cloud API Settings (when WHATSAPP_GATEWAY_TYPE=meta)
# Obtained from Meta Developer Portal -> WhatsApp -> API Setup
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here
META_WHATSAPP_TOKEN=your_meta_system_user_permanent_access_token_here
META_GRAPH_VERSION=v21.0
META_VERIFY_TOKEN=your_custom_webhook_secret_verify_token_here

# Open-Source QR Bridge Settings (when WHATSAPP_GATEWAY_TYPE=bridge)
BRIDGE_API_URL=http://localhost:8080
BRIDGE_API_KEY=your_optional_bridge_api_key_here

# ------------------------------------------------------------------------------
# Scheduler & Anti-Ban Throttling Controls
# ------------------------------------------------------------------------------
# How often to check for due appointments (in seconds)
SCHEDULER_INTERVAL_SECONDS=60

# Anti-ban randomized jitter sleep between dispatched messages (seconds)
RATE_LIMIT_MIN_JITTER_SECONDS=3.0
RATE_LIMIT_MAX_JITTER_SECONDS=8.0

# Maximum reminders dispatched in a single batch cycle
MAX_BATCH_SIZE=20

# Default hours before appointment to send reminder (if not explicitly specified)
DEFAULT_REMINDER_LEAD_HOURS=24

# Default international country code to prepend if customer phone lacks it (e.g., +1 or +44)
DEFAULT_COUNTRY_CODE=+1

# ------------------------------------------------------------------------------
# Multi-Tenant Default Fallback
# ------------------------------------------------------------------------------
DEFAULT_CLIENT_ID=default_tenant
DEFAULT_BUSINESS_NAME=Apex Wellness & Clinic
DEFAULT_BUSINESS_TYPE=Healthcare & Aesthetic Clinic
